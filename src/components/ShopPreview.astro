---
import { products } from '../data/products';
import ProductCard from './ProductCard.astro';

const featured = [
  'gouden-lavendel-zeep-roosjes',
  'ambachtelijke-zeep-naturel',
  'blue-berry-conditioner',
  'rescue-balm',
  'body-cream-rice-flower',
  'giftset-natural-byroos',
];
const featuredProducts = featured
  .map(slug => products.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<section id="shop" class="py-32 lg:py-40" style="background: var(--color-cream);">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">

    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
      <div class="max-w-xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="block w-10 h-px" style="background: var(--color-sage);"></span>
          <span class="section-label">De shop · 01</span>
        </div>
        <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05]" style="font-family: var(--font-heading); color: var(--color-ink); font-weight: 300;">
          Onze <em style="color: var(--color-forest);">favorieten</em><br/>uit het assortiment.
        </h2>
      </div>
      <div class="flex items-center gap-3">
        <a href="/shop" class="text-sm font-medium border-b pb-1 transition-opacity hover:opacity-60"
           style="color: var(--color-ink); font-family: var(--font-body); border-color: var(--color-ink);">
          Bekijk de hele shop
        </a>
      </div>
    </div>

    <!-- Product carousel/grid -->
    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-x-4 gap-y-12">
      {featuredProducts.map(product => <ProductCard product={product} />)}
    </div>

    <!-- Brand strip -->
    <div class="mt-20 pt-10 border-t" style="border-color: var(--color-sand-dark);">
      <p class="text-[10px] uppercase tracking-[0.18em] mb-6 text-center" style="color: var(--color-muted); font-family: var(--font-body);">Merken die wij voeren</p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-4">
        {['Natural ByRoos', 'Loveli', 'Beesha', 'Cosmeau', 'Bamboozy', 'Ben&Anna', 'Shampoobars'].map(brand => (
          <span class="text-base lg:text-lg italic" style="color: var(--color-ink-soft); font-family: var(--font-heading); font-weight: 300;">
            {brand}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
