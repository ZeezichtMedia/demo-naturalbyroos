---
---
<section class="relative min-h-screen flex items-end lg:items-center overflow-hidden" style="background: var(--color-cream);">

  <!-- Subtle grain/texture overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.04] mix-blend-multiply"
       style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);"></div>

  <div class="relative max-w-[1440px] mx-auto px-6 lg:px-12 pt-32 pb-12 lg:pb-0 w-full">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center min-h-[calc(100vh-8rem)]">

      <!-- Left: editorial content -->
      <div class="lg:col-span-5 space-y-10 lg:py-20">
        <div class="flex items-center gap-3">
          <span class="block w-12 h-px" style="background: var(--color-sage);"></span>
          <span class="section-label">Sinds 2021 · Zeeland</span>
        </div>

        <h1 class="text-[clamp(3rem,7vw,6.5rem)] leading-[0.95] tracking-tight"
            style="color: var(--color-ink); font-family: var(--font-heading); font-weight: 300;">
          Duurzaam,<br/>
          <span class="italic" style="color: var(--color-forest); font-weight: 300;">persoonlijk</span><br/>
          en dichtbij.
        </h1>

        <p class="text-base lg:text-lg leading-[1.7] max-w-md"
           style="color: var(--color-ink-soft); font-family: var(--font-body); font-weight: 300;">
          Handgemaakte verzorgingsproducten uit Zeeland — gemaakt met aandacht voor jou én de aarde. Op maat samengesteld, persoonlijk gepersonaliseerd, of gewoon zoals ze zijn.
        </p>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="#gepersonaliseerd" class="btn-primary">
            Ontdek maatwerk
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          </a>
          <a href="#shop" class="text-sm font-medium border-b pb-1 transition-all hover:gap-2"
             style="color: var(--color-ink); font-family: var(--font-body); border-color: var(--color-ink);">
            Naar de shop
          </a>
        </div>

        <!-- USP row -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t" style="border-color: var(--color-sand-dark);">
          <div>
            <p class="text-3xl mb-1" style="font-family: var(--font-heading); color: var(--color-forest); font-weight: 300;">9.9</p>
            <p class="text-[11px] leading-tight" style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.04em;">Klantbeoordeling<br/>(28 reviews)</p>
          </div>
          <div>
            <p class="text-3xl mb-1" style="font-family: var(--font-heading); color: var(--color-forest); font-weight: 300;">3</p>
            <p class="text-[11px] leading-tight" style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.04em;">Afhaalpunten<br/>in Zeeland</p>
          </div>
          <div>
            <p class="text-3xl mb-1" style="font-family: var(--font-heading); color: var(--color-forest); font-weight: 300;">100%</p>
            <p class="text-[11px] leading-tight" style="color: var(--color-muted); font-family: var(--font-body); letter-spacing: 0.04em;">Natuurlijke<br/>ingrediënten</p>
          </div>
        </div>
      </div>

      <!-- Right: editorial image collage -->
      <div class="lg:col-span-7 relative h-[480px] sm:h-[600px] lg:h-[760px]">

        <!-- Main feature image -->
        <div class="absolute top-0 right-0 w-[72%] h-[80%] overflow-hidden rounded-[2px] shadow-[0_30px_80px_-20px_rgba(0,0,0,0.25)]">
          <img src="/images/personalised-soap-real.jpg" alt="Gouden Lavendel Zeep Roosjes"
               class="w-full h-full object-cover transition-transform duration-[2s] hover:scale-105" />
          <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.15) 100%);"></div>

          <!-- Floating product label -->
          <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between text-white">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em] mb-1 opacity-80" style="font-family: var(--font-body);">Gepersonaliseerd</p>
              <p class="text-2xl lg:text-3xl" style="font-family: var(--font-heading); font-weight: 400;">Lavendel zeep<br/><em class="font-light">"Roosjes"</em></p>
            </div>
            <span class="text-sm font-light" style="font-family: var(--font-heading);">v.a. €4,50</span>
          </div>
        </div>

        <!-- Secondary card: detail -->
        <div class="absolute bottom-0 left-0 w-[48%] h-[42%] overflow-hidden rounded-[2px] shadow-[0_20px_50px_-15px_rgba(0,0,0,0.25)]">
          <img src="/images/ambachtelijke-zeep.jpg" alt="Ambachtelijke zeep Natural ByRoos"
               class="w-full h-full object-cover" />
        </div>

        <!-- Stamp card -->
        <div class="absolute top-[42%] left-[6%] w-32 h-32 lg:w-40 lg:h-40 rounded-full flex items-center justify-center text-center shadow-xl rotate-[-6deg] transition-transform hover:rotate-0 duration-500"
             style="background: var(--color-forest); color: white;">
          <div class="px-3">
            <p class="text-[9px] uppercase tracking-[0.25em] mb-1 opacity-70" style="font-family: var(--font-body);">100% Hand-<br/>gemaakt in</p>
            <p class="text-lg" style="font-family: var(--font-heading); font-weight: 400;">Zeeland</p>
            <div class="w-6 h-px mx-auto my-1.5 opacity-50" style="background: white;"></div>
            <p class="text-[9px] tracking-[0.15em] opacity-70" style="font-family: var(--font-body);">EST. 2021</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom strip: marquee-style USP -->
    <div class="hidden lg:flex absolute bottom-6 left-12 right-12 items-center justify-between text-[11px] uppercase tracking-[0.2em]"
         style="color: var(--color-muted); font-family: var(--font-body);">
      <span class="flex items-center gap-2">
        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        Persoonlijk advies
      </span>
      <span>Afhalen Grijpskerke · Kloetinge · Burgh-Haamstede</span>
      <span>www.naturalbyroos.nl</span>
    </div>
  </div>
</section>
