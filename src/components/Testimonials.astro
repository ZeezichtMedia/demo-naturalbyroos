---
const reviews = [
  {
    name: 'Marieke V.',
    location: 'Middelburg',
    rating: 5,
    text: 'De gepersonaliseerde zeepjes voor onze bruiloft waren een groot succes. Iedereen vond het zo\'n lief en bijzonder cadeau. Roos was super behulpzaam bij het uitzoeken van geur en tekst.',
    occasion: 'Bruiloft, 80 stuks',
  },
  {
    name: 'Tom B.',
    location: 'Goes',
    rating: 5,
    text: 'Als bedrijf hadden wij een duurzaam relatiegeschenk nodig. De badzoutzakjes met ons logo waren perfect. Snelle levering, eerlijke prijs en prachtig eindresultaat.',
    occasion: 'Zakelijk, 120 stuks',
  },
  {
    name: 'Sandra K.',
    location: 'Vlissingen',
    rating: 5,
    text: 'Ik koop al jarenlang bij Natural ByRoos. De kwaliteit is consistent, de producten ruiken heerlijk en het is fijn dat alles zo duurzaam is. Een echte aanrader.',
    occasion: 'Vaste klant',
  },
];
---

<section class="py-32 lg:py-40 overflow-hidden" style="background: var(--color-cream);">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">

    <div class="grid lg:grid-cols-12 gap-12 mb-20">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-6">
          <span class="block w-10 h-px" style="background: var(--color-sage);"></span>
          <span class="section-label">Klantervaring · 04</span>
        </div>
        <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] mb-8" style="font-family: var(--font-heading); color: var(--color-ink); font-weight: 300;">
          Wat klanten<br/><em style="color: var(--color-forest);">echt zeggen.</em>
        </h2>

        <!-- Big rating display -->
        <div class="flex items-baseline gap-4 pt-4 border-t" style="border-color: var(--color-sand-dark);">
          <span class="text-7xl lg:text-8xl leading-none" style="color: var(--color-forest); font-family: var(--font-heading); font-weight: 300;">9.9</span>
          <div class="pb-2">
            <div class="flex gap-0.5 mb-1">
              {Array(5).fill(null).map(() => (
                <svg class="w-4 h-4" style="color: var(--color-amber);" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <span class="text-xs" style="color: var(--color-muted); font-family: var(--font-body);">28 beoordelingen</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7 lg:pt-12">
        <p class="text-base lg:text-lg leading-[1.7]" style="color: var(--color-ink-soft); font-family: var(--font-body); font-weight: 300;">
          Sinds 2021 maken we duurzame, persoonlijke producten voor klanten in heel Nederland. Van trouwbedankjes tot zakelijke relatiegeschenken — telkens met dezelfde aandacht en kwaliteit.
        </p>
      </div>
    </div>

    <!-- Reviews -->
    <div class="grid md:grid-cols-3 gap-px" style="background: var(--color-sand-dark);">
      {reviews.map((review) => (
        <div class="p-8 lg:p-10 transition-all duration-300 hover:bg-white" style="background: var(--color-cream);">
          <div class="flex gap-0.5 mb-6">
            {Array(review.rating).fill(null).map(() => (
              <svg class="w-3.5 h-3.5" style="color: var(--color-amber);" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <p class="text-base leading-[1.7] mb-8" style="color: var(--color-ink); font-family: var(--font-heading); font-weight: 400; font-style: italic;">
            "{review.text}"
          </p>

          <div class="pt-6 border-t flex items-center justify-between" style="border-color: var(--color-sand-dark);">
            <div>
              <p class="text-sm font-medium" style="color: var(--color-ink); font-family: var(--font-body);">{review.name}</p>
              <p class="text-[11px] uppercase tracking-[0.1em] mt-0.5" style="color: var(--color-muted); font-family: var(--font-body);">{review.location}</p>
            </div>
            <span class="text-[10px] uppercase tracking-[0.15em]" style="color: var(--color-sage); font-family: var(--font-body);">{review.occasion}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
